    {
      "parameters": {
        "jsCode": "const t = $input.item.json;\nconst summary = `Customer: ${t.customer_name} (${t.customer_email})\\n`\n  + `Channel: ${t.channel}\\n`\n  + `Sentiment: ${t.sentiment} | Frustration: ${t.frustration_level}/10\\n`\n  + `Cancellation threat: ${t.contains_cancellation_threat} | Billing dispute: ${t.contains_billing_dispute}\\n`\n  + `Escalation reason: ${t.escalation_reason}\\n`\n  + `Message: ${t.message_text}\\n`\n  + (t.kb_snippets && t.kb_snippets.length ? `Closest KB matches for reference:\\n- ${t.kb_snippets.join('\\n- ')}` : 'No close KB matches found.');\n\nreturn [{ json: { ...t, enriched_summary: summary } }];"
      },
