    {
      "parameters": {},
      "id": "ce7c76e3-289e-4f07-a5bf-e128bd0401f3",
      "name": "Merge Ticket Sources",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        -1360,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "const ticket = $('Merge Ticket Sources').first().json;\nconst items = $input.all();\n\nconst matches = items\n  .filter(item => item.json && (item.json.pageContent || item.json.text))\n  .map(item => {\n    const j = item.json;\n    const text = j.pageContent || j.text || '';\n    const score = j.score !== undefined ? j.score : ((j.metadata && j.metadata.score !== undefined) ? j.metadata.score : 0);\n    return { score, text };\n  })\n  .sort((a, b) => b.score - a.score);\n\nconst topScore = matches.length ? matches[0].score : 0;\nconst kbSnippets = matches.map(m => m.text).filter(Boolean);\n\nreturn [{\n  json: {\n    ...ticket,\n    kb_confidence: topScore,\n    kb_snippets: kbSnippets\n  }\n}];"
      },
      "id": "20853e72-e8b1-407f-84cf-d8c533771357",
      "name": "Code: Extract Top Match & Confidence",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -688,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "const ticket = $('Code: Extract Top Match & Confidence').item.json;\nconst raw = $input.item.json.content[0].text;\nconst cleaned = raw.replace(/```json|```/g, '').trim();\nlet sentiment;\ntry {\n  sentiment = JSON.parse(cleaned);\n} catch (e) {\n  sentiment = { sentiment: 'neutral', frustration_level: 0, contains_cancellation_threat: false, contains_billing_dispute: false, one_line_summary: 'Could not parse AI sentiment response' };\n}\n\nreturn [{ json: { ...ticket, ...sentiment } }];"
      },
      "id": "f5ea02f6-4232-41cb-b049-f6a87b359a35",
      "name": "Code: Parse Sentiment Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "const t = $input.item.json;\n\nconst highConfidence = (t.kb_confidence || 0) >= 0.80;\nconst safeSentiment = t.sentiment !== 'negative';\nconst noThreatFlags = !t.contains_cancellation_threat && !t.contains_billing_dispute;\n\nconst autoResolve = highConfidence && safeSentiment && noThreatFlags;\n\nlet priority = 'normal';\nif (t.contains_cancellation_threat || t.contains_billing_dispute || (t.frustration_level || 0) >= 7) {\n  priority = 'urgent';\n}\n\nlet escalationReason = '';\nif (!autoResolve) {\n  const reasons = [];\n  if (!highConfidence) reasons.push(`low KB match confidence (${(t.kb_confidence || 0).toFixed(2)})`);\n  if (!safeSentiment) reasons.push('negative sentiment');\n  if (t.contains_cancellation_threat) reasons.push('cancellation threat detected');\n  if (t.contains_billing_dispute) reasons.push('billing dispute detected');\n  escalationReason = reasons.join('; ');\n}\n\nreturn [{\n  json: {\n    ...t,\n    decision: autoResolve ? 'auto_resolve' : 'escalate',\n    priority,\n    escalation_reason: escalationReason\n  }\n}];"
      },
      "id": "9c40b1ad-c4b7-41de-8f07-4da088f746e9",
      "name": "Code: Decision Logic (Auto-Resolve vs Escalate)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -16,
        208
      ]
    },
