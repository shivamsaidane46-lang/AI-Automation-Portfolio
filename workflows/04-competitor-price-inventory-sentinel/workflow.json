    {
      "parameters": {
        "jsCode": "const raw = $input.item.json.content[0].text;\nconst cleaned = raw.replace(/```json|```/g, '').trim();\nlet data;\ntry {\n  data = JSON.parse(cleaned);\n} catch (e) {\n  return [{ json: { validation_passed: false, validation_reason: 'AI response was not valid JSON', raw_response: raw } }];\n}\n\nconst lineItems = data.line_items || [];\nconst computedSum = lineItems.reduce((sum, li) => sum + (Number(li.amount) || 0), 0);\nconst grandTotal = Number(data.grand_total) || 0;\nconst tolerance = 0.01;\nconst amountsMatch = Math.abs(computedSum - grandTotal) <= tolerance;\nconst hasTaxId = data.tax_id !== null && data.tax_id !== undefined && String(data.tax_id).trim() !== '';\n\nlet reason = '';\nif (!amountsMatch) reason = `Line items sum to ${computedSum.toFixed(2)} but grand total is ${grandTotal.toFixed(2)}`;\nelse if (!hasTaxId) reason = 'Tax ID missing from document';\n\nreturn [{\n  json: {\n    ...data,\n    computed_line_item_sum: computedSum,\n    validation_passed: amountsMatch && hasTaxId,\n    validation_reason: reason\n  }\n}];"
      },
