      ]
    },
    {
      "parameters": {
        "content": "## 5B. EXCEPTION PATH\nFile is moved to /Needs-Review, an exception record is logged with the specific reason (amount mismatch vs. missing field), and the AP team is alerted in Slack with a direct link to the file.",
        "height": 340,
        "width": 760,
        "color": 7
      },
      "id": "35089b9e-a6e2-40fe-ba2b-80d7ce9a86f4",
