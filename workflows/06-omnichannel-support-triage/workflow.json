    {
      "parameters": {
        "operation": "extractHtmlContent",
        "extractionValues": {
          "values": [
            {
              "key": "price_text",
              "cssSelector": "={{ $('Loop Over Watchlist').item.json.price_selector }}"
            },
            {
              "key": "stock_text",
              "cssSelector": "={{ $('Loop Over Watchlist').item.json.stock_selector }}"
            },
            {
              "key": "shipping_text",
              "cssSelector": "={{ $('Loop Over Watchlist').item.json.shipping_selector }}"
            }
          ]
        },
        "options": {}
      },
      "id": "ce337cf1-463f-4283-b396-a036893b706c",
      "name": "HTML: Extract Price, Stock & Shipping",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        -800,
        352
      ]
    },
    {
      "parameters": {
        "jsCode": "const watch = $('Loop Over Watchlist').item.json;\nconst scraped = $input.item.json;\n\nconst priceMatch = String(scraped.price_text || '').replace(/[^0-9.]/g, '');\nconst price = priceMatch ? parseFloat(priceMatch) : null;\n\nconst stockText = String(scraped.stock_text || '').toLowerCase();\nconst inStock = !(stockText.includes('out of stock') || stockText.includes('sold out') || stockText.includes('unavailable'));\n\nreturn [{\n  json: {\n    competitor: watch.competitor,\n    our_sku: watch.our_sku,\n    product_url: watch.product_url,\n    price: price,\n    in_stock: inStock,\n    shipping_terms: (scraped.shipping_text || '').trim(),\n    scraped_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "a0383ba8-1bff-4f34-b8f9-cfbcca43513a",
      "name": "Code: Normalize Scraped Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -560,
        416
      ]
    },
    {
      "parameters": {
        "operation": "search",
        "base": {
          "mode": "list",
          "value": "YOUR_AIRTABLE_BASE_ID"
        },
        "table": {
          "mode": "list",
          "value": "Price History"
        },
        "filterByFormula": "=AND({SKU} = '{{ $json.our_sku }}', {Competitor} = '{{ $json.competitor }}')",
        "options": {},
        "sort": {
          "property": [
            {
              "field": "Scraped At",
              "direction": "desc"
            }
          ]
        }
      },
      "id": "dd9b7dfa-9024-43ca-a40f-cf2a2fa3c4cb",
      "name": "Airtable: Get Previous Snapshot",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [
        -368,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const current = $('Code: Normalize Scraped Data').item.json;\nconst previousItems = $input.all();\nconst previous = previousItems.length ? previousItems[0].json : null;\n\nlet priceDeltaPct = null;\nlet wentOutOfStock = false;\nlet reason = '';\n\nif (previous && previous.Price != null && current.price != null && previous.Price > 0) {\n  priceDeltaPct = ((current.price - previous.Price) / previous.Price) * 100;\n}\n\nif (previous && previous['In Stock'] === true && current.in_stock === false) {\n  wentOutOfStock = true;\n}\n\nconst priceDropSignificant = priceDeltaPct !== null && priceDeltaPct <= -10;\n\nif (priceDropSignificant) reason = `Price dropped ${Math.abs(priceDeltaPct).toFixed(1)}% (was ${previous.Price}, now ${current.price})`;\nelse if (wentOutOfStock) reason = 'Went from In Stock to Out of Stock';\n\nreturn [{\n  json: {\n    ...current,\n    previous_price: previous ? previous.Price : null,\n    price_delta_pct: priceDeltaPct,\n    is_opportunity: priceDropSignificant || wentOutOfStock,\n    opportunity_reason: reason\n  }\n}];"
      },
      "id": "7218b2d1-ca0e-4316-bf01-ee8c95322010",
      "name": "Code: Compute Variance & Flag Opportunity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
        400
      ]
    },
    {
      "parameters": {
        "operation": "create",
        "base": {
          "mode": "list",
          "value": "YOUR_AIRTABLE_BASE_ID"
