            "Competitor": "={{ $json.competitor }}",
            "Product URL": "={{ $json.product_url }}",
            "Price": "={{ $json.price }}",
            "In Stock": "={{ $json.in_stock }}",
            "Shipping Terms": "={{ $json.shipping_terms }}",
            "Scraped At": "={{ $json.scraped_at }}",
            "Price Delta %": "={{ $json.price_delta_pct }}",
            "Is Opportunity": "={{ $json.is_opportunity }}",
            "Opportunity Reason": "={{ $json.opportunity_reason }}"
          }
        },
        "options": {}
