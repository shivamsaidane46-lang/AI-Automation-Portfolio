    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nif (items.length === 0) {\n  return [{ json: { has_opportunities: false, digest_text: '' } }];\n}\n\nconst lines = items.map(r => `• *${r.Competitor}* — ${r['Opportunity Reason']} (SKU ${r.SKU}) — ${r['Product URL']}`);\nconst digestText = `📊 *Competitor Watch — Morning Digest*\\n${items.length} opportunity${items.length === 1 ? '' : 'ies'} in the last 24h:\\n\\n${lines.join('\\n')}`;\n\nreturn [{ json: { has_opportunities: true, digest_text: digestText } }];"
      },
      "id": "283ec07e-4b7d-49e3-afc8-4cd80dc09bdb",
      "name": "Code: Format Digest Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
